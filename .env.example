DATABASE_URL="postgresql://edutech:edutech@127.0.0.1:5433/edutech?schema=public"
# 32+ random chars: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-of-32-chars"
APP_URL="http://localhost:3100"

# Free plan limits
FREE_DAILY_LIMIT=20

# Paystack (use test keys in development)
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# Google sign-in (optional; the button is hidden until both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Automatic YouTube solution videos (optional). Without a key, only teacher-added videos show.
# Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key (restrict it to that API).
YOUTUBE_API_KEY=""

# Videos a free-plan student can watch per day (Lagos time), on top of teacher-marked free samples. 0 = samples only.
FREE_DAILY_VIDEOS=0

# Testing only: give every account Premium (no daily limit, every video). Ignored on Vercel production.
# PREMIUM_FOR_EVERYONE=true
